# API key lấy tại https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model phân tích video đầu vào
ANALYZE_MODEL=gemini-2.5-flash
# Model tạo video (Veo). Đổi sang model Veo khác nếu tài khoản của bạn có quyền.
VEO_MODEL=veo-3.1-fast-generate-preview

# Số video tạo song song (Veo có rate limit, nên để 2-4)
CONCURRENCY=3
PORT=3000

# MOCK=1 để chạy thử giao diện mà không gọi API (video giả bằng ffmpeg)
MOCK=0
APP_PASSWORD=
