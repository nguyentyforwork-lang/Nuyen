# Lấy token tại https://replicate.com/account/api-tokens
# Bỏ trống => chạy chế độ DEMO (không gọi AI, chỉ thử giao diện)
REPLICATE_API_TOKEN=

PORT=3000

# Model tạo mặt AI từ prompt
FACE_MODEL=black-forest-labs/flux-schnell

# Model ghép mặt vào video (có thể ghi dạng owner/name:version để cố định version)
SWAP_MODEL=arabyai-replicate/roop_face_swap
# Tên tham số input của model ghép mặt (đổi nếu dùng model khác)
SWAP_FACE_KEY=swap_image
SWAP_VIDEO_KEY=target_video
