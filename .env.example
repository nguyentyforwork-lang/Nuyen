# ===== TikTok Business API =====
# Access token lấy từ TikTok for Business Developer (long-term token của app)
TIKTOK_ACCESS_TOKEN=
# App ID + Secret: dùng để liệt kê toàn bộ ad account mà token được ủy quyền (/oauth2/advertiser/get/)
TIKTOK_APP_ID=
TIKTOK_SECRET=
# (Tuỳ chọn) Danh sách Business Center ID, cách nhau bởi dấu phẩy — lấy thêm toàn bộ ad account trong BC
TIKTOK_BC_IDS=
# (Tuỳ chọn) Thêm advertiser ID thủ công, cách nhau bởi dấu phẩy
TIKTOK_ADVERTISER_IDS=

# ===== Web =====
PORT=3000
# Đặt mật khẩu để bảo vệ trang (Basic Auth, user tuỳ ý). Để trống = không khoá (KHÔNG khuyến nghị khi deploy public)
APP_PASSWORD=
# Múi giờ dùng để lọc "theo ngày"
TZ_DISPLAY=Asia/Ho_Chi_Minh
# Chỉ quét các ad được tạo trong N ngày gần nhất (TikTok khuyến nghị <= 180)
CREATIVE_LOOKBACK_DAYS=90

# Chạy với dữ liệu giả để thử giao diện, không gọi TikTok: MOCK=1
MOCK=0
