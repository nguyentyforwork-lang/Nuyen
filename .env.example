# ---------------- MCP configuration (server-side only) ----------------
# Official TikTok for Business MCP server endpoint (prefer the full-disclosure endpoint).
TIKTOK_MCP_URL=
# Header that carries the credential, and its full value. Never exposed to the browser.
TIKTOK_MCP_AUTH_HEADER=Authorization
TIKTOK_MCP_AUTH_TOKEN=
# Optional JSON object of extra headers required by the endpoint.
# TIKTOK_MCP_EXTRA_HEADERS={"x-example":"value"}
TIKTOK_MCP_TIMEOUT_MS=60000
TIKTOK_MCP_MAX_CONCURRENCY=4
# IAA D0: unset by default because no such metric is accepted by TikTok MCP reporting today
# (see docs/MCP_TOOL_MAPPING.md). Any value is validated against the live API before use.
# TIKTOK_IAA_D0_REVENUE_METRIC=
# TIKTOK_IAA_D0_ROAS_METRIC=
# TIKTOK_IAA_D0_ROAS_SCALE=ratio

# ---------------- Database configuration ----------------
DATABASE_URL=postgres://tacc:tacc@localhost:5432/tacc

# ---------------- Application configuration ----------------
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_CACHE_TTL_SECONDS=90
APP_MIN_REFRESH_INTERVAL_SECONDS=15
APP_MAX_BUDGET_INCREASE_PCT=50
APP_MAX_BUDGET_DECREASE_PCT=50
APP_DEFAULT_MIN_CREATIVE_SPEND=20
APP_PENDING_ACTION_TTL_SECONDS=300
# password: built-in login (APP_USERS via `npm run hash-password -- <user> <pass>`)
# proxy_header: trust an SSO reverse proxy header (only if the app is reachable solely via that proxy)
APP_AUTH_MODE=password
APP_AUTH_PROXY_HEADER=x-forwarded-email
APP_USERS=
APP_SESSION_SECRET=
APP_SECURE_COOKIES=true
