# Access token TikTok Business API (Marketing API) có quyền BC + Reporting + App Management
TIKTOK_ACCESS_TOKEN=
# Để trống token => chạy chế độ DEMO với dữ liệu giả
PORT=3000

# (tuỳ chọn) bảo vệ web bằng mật khẩu (Basic Auth, user tuỳ ý)
APP_PASSWORD=

# Metric revenue IAA dùng để tính ROAS IAA D0 (đã verify với API: total_in_app_ad_impr_value)
IAA_REVENUE_METRIC=total_in_app_ad_impr_value

# Ngưỡng coi là "chạm max budget" (spend/budget ngày)
BUDGET_HIT_THRESHOLD=0.95

# Tỷ giá quy đổi về USD để cộng dồn các account khác currency
FX_TO_USD={"USD":1,"VND":0.000038,"EUR":1.08,"JPY":0.0067,"THB":0.028}

# Số advertiser gọi song song (TikTok giới hạn QPS, đừng để quá cao)
CONCURRENCY=4
# Cache kết quả (giây)
CACHE_TTL=300
